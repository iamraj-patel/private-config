#!/bin/bash

# --- 1. PRE-EXECUTION HOOK ---
trap '[[ -z "$_CMD_START" ]] && _CMD_START=$SECONDS' DEBUG

# --- 2. THE MASTER BUILDER ---
build_prompt() {
    local EXIT="$?"
    
    # --- Sticky-Error Logic ---
    local current_hist
    current_hist=$(history 1 2>/dev/null | awk '{print $1}')
    if [[ "$current_hist" == "$_LAST_HIST" || -z "$current_hist" ]]; then
        _VISUAL_EXIT=0
    else
        _VISUAL_EXIT=$EXIT
    fi
    _LAST_HIST=$current_hist

    # --- Colors & The Neon Engine ---
    local colors=(39 45 51 81 118 123 154 190 197 201 208 214 220 226)
    local C_RESET="\[\033[0m\]"
    local SACRED="\[\033[1;38;5;208m\]"
    local ERROR="\[\033[1;31m\]"
    local SUCCESS="\[\033[38;5;118m\]"
    local C_FRAME="\[\033[38;5;237m\]"
    local C_TIME="\[\033[38;5;242m\]" # Dim grey for time
    
    local rand_u="${colors[RANDOM % 14]}"
    local rand_p="${colors[RANDOM % 14]}"
    local rand_t="${colors[RANDOM % 14]}"

    # --- Context & Permissions ---
    [[ "$HOSTNAME" == *prod* ]] && C_FRAME="\[\033[1;31m\]"
    
    local C_USER="\[\033[38;5;${rand_u}m\]"
    local ROLE_ICON="🔱"
    if (( EUID == 0 )); then
        C_USER="\[\033[1;31m\]"
        ROLE_ICON="⚡"
    fi

    # --- Telemetry (Load + RAM + Time) ---
    local load_val="0.00"
    [[ -f /proc/loadavg ]] && read -r load_val _ < /proc/loadavg
    local load_c="\[\033[38;5;${rand_t}m\]"
    [[ "${load_val%%.*}" -ge 1 ]] && load_c="\[\033[1;31m\]"

    local mem_pct=0
    if [[ -r /proc/meminfo ]]; then
        local t=0 a=0
        while read -r k v _; do
            [[ $k == "MemTotal:" ]] && t=$v
            [[ $k == "MemAvailable:" ]] && a=$v
            [[ $t -gt 0 && $a -gt 0 ]] && break
        done < /proc/meminfo
        (( t > 0 )) && mem_pct=$(( 100 - (a * 100 / t) ))
    fi
    
    # Get server time + configured timezone
    local srv_time=$(date +%H:%M:%S\ %Z)

    # --- Git Check ---
    local GIT_INFO=""
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local branch
        branch=$(git branch --show-current 2>/dev/null)
        [[ -z "$branch" ]] && branch=$(git rev-parse --short HEAD 2>/dev/null)
        GIT_INFO=" \[\033[38;5;214m\]${branch}"
    fi

    # --- Permissions Check ---
    local LOCK_ICON=""
    [[ ! -w . ]] && LOCK_ICON=" \[\033[38;5;196m\]🔒"

    # --- Execution Timer ---
    local ELAPSED=""
    if [[ -n "$_CMD_START" ]]; then
        local delta=$(( SECONDS - _CMD_START ))
        (( delta >= 2 )) && ELAPSED=" \[\033[38;5;243m\](${delta}s)"
        unset _CMD_START
    fi

    # --- Status Icon & Frame Color ---
    local STAT_ICON="${SUCCESS}✔"
    local B_COLOR="$C_FRAME"
    if (( _VISUAL_EXIT != 0 )); then
        STAT_ICON="${ERROR}✘ ${_VISUAL_EXIT}"
        B_COLOR="$ERROR"
    fi

    # --- ASSEMBLY ---
    # Line 1: [User@Host]─[Time]─[Load]─[RAM]─[Path]
    local L1_HEAD="${C_FRAME}┌─${SACRED}ॐ${C_FRAME}─[${C_USER}\u@\h${C_FRAME}]"
    local L1_TIME="─[${C_TIME}${srv_time}${C_FRAME}]"
    local L1_HEALTH="─${load_c}⏲${load_val} \[\033[38;5;246m\]📋${mem_pct}%${C_FRAME}"
    local L1_PATH="─\[\033[1;38;5;${rand_p}m\]\w${C_RESET}${LOCK_ICON}${GIT_INFO}${ELAPSED}"
    
    local L2="${B_COLOR}└─${C_RESET}${STAT_ICON} ${SACRED}${ROLE_ICON}${C_RESET} \$ "

    PS1="\n${L1_HEAD}${L1_TIME}${L1_HEALTH}${L1_PATH}\n${L2}"
}

PROMPT_COMMAND="build_prompt"
export PROMPT_DIRTRIM=3
