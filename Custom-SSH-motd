## 5. Script: 10-system-info

Gather uptime, load, memory, disk, kernel, and IP.
```bash
sudo tee /etc/update-motd.d/10-system-info > /dev/null <<'EOF'
#!/usr/bin/env bash

# Uptime & Load
UP=$(awk '{print int($1/86400)"d "int($1%86400/3600)"h "int($1%3600/60)"m"}' /proc/uptime)
LOAD=$(cut -d ' ' -f1-3 /proc/loadavg)

# Memory
read -r total used free <<<$(free -m | awk '/^Mem:/ {print $2, $3, $4}')

# Disk
DF=$(df -h / | awk 'NR==2 {print $5 " used (" $3 "/" $2 ")"}')

# Kernel & CPU
KERNEL=$(uname -r)
CPUMODEL=$(awk -F: '/model name/ {print $2; exit}' /proc/cpuinfo)

# Primary IP
IP=$(hostname -I | awk '{print $1}')

cat <<EOM
 Uptime:      ${UP}    Load: ${LOAD}
 Memory:      ${used}MiB / ${total}MiB (${free}MiB free)
 Disk (/):    ${DF}
 Kernel:      ${KERNEL}
 CPU:         ${CPUMODEL}
 IP Address:  ${IP}

EOM
EOF
sudo chmod +x /etc/update-motd.d/10-system-info
```

