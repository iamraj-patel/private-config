#!/usr/bin/env bash
[[ $- != *i* ]] && return

# Cross-Distro Production MOTD
# Supports: Debian, Ubuntu, RHEL, Rocky Linux, AlmaLinux, Oracle Linux
# Purpose: Show actionable system, patch, security, service, and resource status at login.

# ANSI color codes
BOLD='\033[1m'
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
PURPLE='\033[1;35m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'
NC='\033[0m'

WIDTH=74

safe_value() {
  local value="$1"
  local fallback="$2"

  if [ -z "$value" ]; then
    echo "$fallback"
  else
    echo "$value"
  fi
}

print_line() {
  printf "${PURPLE}%${WIDTH}s${NC}\n" "" | tr ' ' '='
}

status_color() {
  local value="$1"
  local warn="$2"
  local crit="$3"

  if [[ "$value" =~ ^[0-9]+$ ]]; then
    if [ "$value" -ge "$crit" ]; then
      echo "$RED"
    elif [ "$value" -ge "$warn" ]; then
      echo "$YELLOW"
    else
      echo "$GREEN"
    fi
  else
    echo "$WHITE"
  fi
}

get_os_name() {
  if [ -f /etc/os-release ]; then
    sed -n 's/^PRETTY_NAME=//p' /etc/os-release 2>/dev/null | tr -d '"'
  else
    echo "Unknown Linux"
  fi
}

get_package_manager() {
  if command -v apt >/dev/null 2>&1; then
    echo "apt"
  elif command -v dnf >/dev/null 2>&1; then
    echo "dnf"
  elif command -v yum >/dev/null 2>&1; then
    echo "yum"
  else
    echo "unknown"
  fi
}

get_package_updates() {
  local pm="$1"

  case "$pm" in
    apt)
      if [ -x /usr/lib/update-notifier/apt-check ]; then
        /usr/lib/update-notifier/apt-check 2>/dev/null | awk -F';' '{print $1}'
      else
        timeout 5 apt list --upgradable 2>/dev/null | tail -n +2 | wc -l
      fi
      ;;
    dnf)
      timeout 8 dnf -q check-update 2>/dev/null \
        | awk 'NF >= 3 && $1 !~ /^Last/ && $1 !~ /^Obsoleting/ {count++} END {print count+0}'
      ;;
    yum)
      timeout 8 yum -q check-update 2>/dev/null \
        | awk 'NF >= 3 && $1 !~ /^Loaded/ && $1 !~ /^Obsoleting/ {count++} END {print count+0}'
      ;;
    *)
      echo "Unknown"
      ;;
  esac
}

get_security_updates() {
  local pm="$1"

  case "$pm" in
    apt)
      if [ -x /usr/lib/update-notifier/apt-check ]; then
        /usr/lib/update-notifier/apt-check 2>/dev/null | awk -F';' '{print $2}'
      else
        timeout 5 apt list --upgradable 2>/dev/null | grep -Ei 'security|ubuntu-security|debian-security' | wc -l
      fi
      ;;
    dnf)
      timeout 8 dnf -q updateinfo list security updates 2>/dev/null \
        | awk 'NF {count++} END {print count+0}'
      ;;
    yum)
      timeout 8 yum -q updateinfo list security updates 2>/dev/null \
        | awk 'NF {count++} END {print count+0}'
      ;;
    *)
      echo "Unknown"
      ;;
  esac
}

get_reboot_status() {
  local pm="$1"

  if [ -f /var/run/reboot-required ]; then
    echo "YES"
    return
  fi

  if command -v needs-restarting >/dev/null 2>&1; then
    timeout 8 needs-restarting -r >/dev/null 2>&1
    local rc=$?

    if [ "$rc" -eq 1 ]; then
      echo "YES"
    elif [ "$rc" -eq 0 ]; then
      echo "NO"
    else
      echo "Unknown"
    fi
    return
  fi

  case "$pm" in
    apt)
      echo "NO"
      ;;
    dnf|yum)
      echo "Unknown"
      ;;
    *)
      echo "Unknown"
      ;;
  esac
}

get_firewall_status() {
  if command -v firewall-cmd >/dev/null 2>&1; then
    firewall-cmd --state 2>/dev/null
  elif command -v ufw >/dev/null 2>&1; then
    ufw status 2>/dev/null | awk -F': ' '/Status:/ {print $2}'
  else
    echo "Tool not installed"
  fi
}

get_selinux_status() {
  if command -v getenforce >/dev/null 2>&1; then
    getenforce 2>/dev/null
  else
    echo "N/A"
  fi
}

get_failed_logins() {
  if [ -r /var/log/btmp ] && command -v lastb >/dev/null 2>&1; then
    lastb 2>/dev/null | grep -vc "btmp begins"
  else
    echo "N/A"
  fi
}

get_ssh_setting() {
  local setting="$1"

  if command -v sshd >/dev/null 2>&1; then
    sshd -T 2>/dev/null | awk -v key="$setting" '$1 == key {print $2}'
  else
    echo "Unavailable"
  fi
}

OS_NAME=$(get_os_name)
OS_NAME=$(safe_value "$OS_NAME" "Unknown Linux")

HOSTNAME=$(hostname 2>/dev/null)
HOSTNAME=$(safe_value "$HOSTNAME" "Unknown")

PACKAGE_MANAGER=$(get_package_manager)

# Header
echo
print_line

title1=" ${HOSTNAME} | Production Administration Console "
printf "${PURPLE}|${NC} ${BOLD}${CYAN}%s${NC}%*s${PURPLE}|${NC}\n" \
  "$title1" $(( WIDTH - ${#title1} - 2 )) ""

title2=" ${OS_NAME} "
printf "${PURPLE}|${NC} ${WHITE}%s${NC}%*s${PURPLE}|${NC}\n" \
  "$title2" $(( WIDTH - ${#title2} - 2 )) ""

print_line
echo

# System overview
KERNEL=$(uname -r 2>/dev/null)
ARCH=$(uname -m 2>/dev/null)
UPTIME=$(uptime -p 2>/dev/null)
BOOT_TIME=$(uptime -s 2>/dev/null)
CPU_CORES=$(nproc 2>/dev/null)
LOAD_AVG=$(uptime 2>/dev/null | awk -F'load average: ' '{print $2}')
USERS_LOGGED_IN=$(who 2>/dev/null | wc -l)

KERNEL=$(safe_value "$KERNEL" "Unknown")
ARCH=$(safe_value "$ARCH" "Unknown")
UPTIME=$(safe_value "$UPTIME" "Unknown")
BOOT_TIME=$(safe_value "$BOOT_TIME" "Unknown")
CPU_CORES=$(safe_value "$CPU_CORES" "Unknown")
LOAD_AVG=$(safe_value "$LOAD_AVG" "Unknown")
USERS_LOGGED_IN=$(safe_value "$USERS_LOGGED_IN" "Unknown")

echo -e "${BOLD}${YELLOW}System Overview${NC}"
echo -e "  ${GREEN}Hostname:${NC}          ${HOSTNAME}"
echo -e "  ${GREEN}OS:${NC}                ${OS_NAME}"
echo -e "  ${GREEN}Kernel:${NC}            ${KERNEL}"
echo -e "  ${GREEN}Architecture:${NC}      ${ARCH}"
echo -e "  ${GREEN}Uptime:${NC}            ${UPTIME}"
echo -e "  ${GREEN}Boot Time:${NC}         ${BOOT_TIME}"
echo -e "  ${GREEN}CPU Cores:${NC}         ${CPU_CORES}"
echo -e "  ${GREEN}Users Logged In:${NC}   ${USERS_LOGGED_IN}"
echo -e "  ${GREEN}Load Average:${NC}      ${LOAD_AVG}"
echo

# Resource usage
CPU_IDLE=$(top -bn1 2>/dev/null | awk '/Cpu\(s\):/ {print $8}')

if [[ "$CPU_IDLE" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  CPU_PCT=$(awk -v idle="$CPU_IDLE" 'BEGIN {printf "%.0f", 100 - idle}')
else
  CPU_PCT="0"
fi

CPU_USAGE="${CPU_PCT}%"

MEM_USAGE=$(free -h 2>/dev/null | awk '/^Mem:/ {print $3 " used of " $2}')
MEM_PCT=$(free 2>/dev/null | awk '/^Mem:/ {printf "%.0f", ($3/$2)*100}')

SWAP_USAGE=$(free -h 2>/dev/null | awk '/^Swap:/ {print $3 " used of " $2}')
SWAP_PCT=$(free 2>/dev/null | awk '/^Swap:/ {if ($2 > 0) printf "%.0f", ($3/$2)*100; else print 0}')

DISK_USAGE=$(df -h / 2>/dev/null | awk 'NR==2 {print $5 " used of " $2}')
DISK_PCT=$(df / 2>/dev/null | awk 'NR==2 {gsub("%","",$5); print $5}')

INODE_PCT=$(df -i / 2>/dev/null | awk 'NR==2 {gsub("%","",$5); print $5}')
PROCS=$(ps ax --no-heading 2>/dev/null | wc -l)

MEM_USAGE=$(safe_value "$MEM_USAGE" "Unknown")
MEM_PCT=$(safe_value "$MEM_PCT" "0")
SWAP_USAGE=$(safe_value "$SWAP_USAGE" "Unknown")
SWAP_PCT=$(safe_value "$SWAP_PCT" "0")
DISK_USAGE=$(safe_value "$DISK_USAGE" "Unknown")
DISK_PCT=$(safe_value "$DISK_PCT" "0")
INODE_PCT=$(safe_value "$INODE_PCT" "0")
PROCS=$(safe_value "$PROCS" "Unknown")

CPU_COLOR=$(status_color "$CPU_PCT" 80 90)
MEM_COLOR=$(status_color "$MEM_PCT" 80 90)
SWAP_COLOR=$(status_color "$SWAP_PCT" 50 80)
DISK_COLOR=$(status_color "$DISK_PCT" 80 90)
INODE_COLOR=$(status_color "$INODE_PCT" 80 90)

echo -e "${BOLD}${YELLOW}Resource Usage${NC}"
echo -e "  ${GREEN}CPU Usage:${NC}         ${CPU_COLOR}${CPU_USAGE}${NC}"
echo -e "  ${GREEN}Memory Usage:${NC}      ${MEM_COLOR}${MEM_USAGE} (${MEM_PCT}%)${NC}"
echo -e "  ${GREEN}Swap Usage:${NC}        ${SWAP_COLOR}${SWAP_USAGE} (${SWAP_PCT}%)${NC}"
echo -e "  ${GREEN}Disk / Usage:${NC}      ${DISK_COLOR}${DISK_USAGE}${NC}"
echo -e "  ${GREEN}Inode / Usage:${NC}     ${INODE_COLOR}${INODE_PCT}% used${NC}"
echo -e "  ${GREEN}Processes:${NC}         ${PROCS}"
echo

# Network information
IP_ADDRESS=$(hostname -I 2>/dev/null | awk '{print $1}')
GATEWAY=$(ip route 2>/dev/null | awk '/default/ {print $3; exit}')
INTERFACE=$(ip route 2>/dev/null | awk '/default/ {print $5; exit}')

DNS_SERVERS=$(grep -E '^nameserver' /etc/resolv.conf 2>/dev/null \
  | awk '{print $2}' \
  | paste -sd ',' - \
  | sed 's/,/, /g')

LISTENING_PORTS=$(ss -H -tuln 2>/dev/null \
  | awk '{print $5}' \
  | sed -E 's/.*:([0-9]+)$/\1/' \
  | grep -E '^[0-9]+$' \
  | sort -n \
  | uniq \
  | paste -sd ',' - \
  | sed 's/,/, /g')

IP_ADDRESS=$(safe_value "$IP_ADDRESS" "Unavailable")
GATEWAY=$(safe_value "$GATEWAY" "Unavailable")
INTERFACE=$(safe_value "$INTERFACE" "Unavailable")
DNS_SERVERS=$(safe_value "$DNS_SERVERS" "Unavailable")
LISTENING_PORTS=$(safe_value "$LISTENING_PORTS" "Unavailable")

echo -e "${BOLD}${YELLOW}Network Information${NC}"
echo -e "  ${GREEN}Primary IP:${NC}        ${IP_ADDRESS}"
echo -e "  ${GREEN}Default Gateway:${NC}   ${GATEWAY}"
echo -e "  ${GREEN}Default Interface:${NC} ${INTERFACE}"
echo -e "  ${GREEN}DNS Servers:${NC}       ${DNS_SERVERS}"
echo -e "  ${GREEN}Listening Ports:${NC}   ${LISTENING_PORTS}"
echo

# Patch and reboot status
UPDATES=$(get_package_updates "$PACKAGE_MANAGER")
SECURITY_UPDATES=$(get_security_updates "$PACKAGE_MANAGER")
REBOOT_REQUIRED=$(get_reboot_status "$PACKAGE_MANAGER")

UPDATES=$(safe_value "$UPDATES" "Unknown")
SECURITY_UPDATES=$(safe_value "$SECURITY_UPDATES" "Unknown")
REBOOT_REQUIRED=$(safe_value "$REBOOT_REQUIRED" "Unknown")

if [[ "$UPDATES" =~ ^[0-9]+$ ]] && [ "$UPDATES" -gt 0 ]; then
  UPDATE_COLOR=$YELLOW
else
  UPDATE_COLOR=$GREEN
fi

if [[ "$SECURITY_UPDATES" =~ ^[0-9]+$ ]] && [ "$SECURITY_UPDATES" -gt 0 ]; then
  SECURITY_COLOR=$RED
else
  SECURITY_COLOR=$GREEN
fi

if [ "$REBOOT_REQUIRED" = "YES" ]; then
  REBOOT_STATUS="${RED}YES - reboot required${NC}"
elif [ "$REBOOT_REQUIRED" = "NO" ]; then
  REBOOT_STATUS="${GREEN}NO${NC}"
else
  REBOOT_STATUS="${YELLOW}Unknown${NC}"
fi

case "$PACKAGE_MANAGER" in
  apt)
    UPDATE_COMMAND="sudo apt update && sudo apt upgrade"
    ;;
  dnf)
    UPDATE_COMMAND="sudo dnf update"
    ;;
  yum)
    UPDATE_COMMAND="sudo yum update"
    ;;
  *)
    UPDATE_COMMAND="Unknown"
    ;;
esac

echo -e "${BOLD}${YELLOW}Patch Status${NC}"
echo -e "  ${GREEN}Package Manager:${NC}   ${PACKAGE_MANAGER}"
echo -e "  ${GREEN}Package Updates:${NC}   ${UPDATE_COLOR}${UPDATES} available${NC}"
echo -e "  ${GREEN}Security Updates:${NC}  ${SECURITY_COLOR}${SECURITY_UPDATES} available${NC}"
echo -e "  ${GREEN}Reboot Required:${NC}   ${REBOOT_STATUS}"
echo -e "  ${GREEN}Update Command:${NC}    ${CYAN}${UPDATE_COMMAND}${NC}"
echo

# Security and service health
FAILED_LOGIN_COUNT=$(get_failed_logins)

SSH_CONNECTIONS="Unavailable"
FAILED_SERVICES="Unavailable"
ROOT_SSH_SETTING="Unavailable"
PASSWORD_AUTH_SETTING="Unavailable"
FIREWALL_STATUS="Unavailable"
SELINUX_STATUS="N/A"

if command -v ss >/dev/null 2>&1; then
  SSH_CONNECTIONS=$(ss -tn 2>/dev/null | awk '$4 ~ /:22$/ || $4 ~ /:ssh$/ {count++} END {print count+0}')
fi

if command -v systemctl >/dev/null 2>&1; then
  FAILED_SERVICES=$(systemctl --failed --no-legend --no-pager 2>/dev/null | wc -l)
fi

ROOT_SSH_SETTING=$(get_ssh_setting "permitrootlogin")
PASSWORD_AUTH_SETTING=$(get_ssh_setting "passwordauthentication")
FIREWALL_STATUS=$(get_firewall_status)
SELINUX_STATUS=$(get_selinux_status)

FAILED_LOGIN_COUNT=$(safe_value "$FAILED_LOGIN_COUNT" "N/A")
SSH_CONNECTIONS=$(safe_value "$SSH_CONNECTIONS" "Unavailable")
FAILED_SERVICES=$(safe_value "$FAILED_SERVICES" "Unavailable")
ROOT_SSH_SETTING=$(safe_value "$ROOT_SSH_SETTING" "Unavailable")
PASSWORD_AUTH_SETTING=$(safe_value "$PASSWORD_AUTH_SETTING" "Unavailable")
FIREWALL_STATUS=$(safe_value "$FIREWALL_STATUS" "Unavailable")
SELINUX_STATUS=$(safe_value "$SELINUX_STATUS" "N/A")

SERVICE_COLOR=$GREEN
if [[ "$FAILED_SERVICES" =~ ^[0-9]+$ ]] && [ "$FAILED_SERVICES" -gt 0 ]; then
  SERVICE_COLOR=$RED
fi

ROOT_SSH_COLOR=$GREEN
if [ "$ROOT_SSH_SETTING" = "yes" ]; then
  ROOT_SSH_COLOR=$RED
elif [ "$ROOT_SSH_SETTING" = "without-password" ] || [ "$ROOT_SSH_SETTING" = "prohibit-password" ]; then
  ROOT_SSH_COLOR=$YELLOW
fi

PASSWORD_AUTH_COLOR=$GREEN
if [ "$PASSWORD_AUTH_SETTING" = "yes" ]; then
  PASSWORD_AUTH_COLOR=$YELLOW
fi

FIREWALL_COLOR=$GREEN
if [ "$FIREWALL_STATUS" != "active" ] && [ "$FIREWALL_STATUS" != "running" ]; then
  FIREWALL_COLOR=$RED
fi

SELINUX_COLOR=$GREEN
if [ "$SELINUX_STATUS" = "Disabled" ]; then
  SELINUX_COLOR=$YELLOW
elif [ "$SELINUX_STATUS" = "Permissive" ]; then
  SELINUX_COLOR=$YELLOW
elif [ "$SELINUX_STATUS" = "Enforcing" ]; then
  SELINUX_COLOR=$GREEN
else
  SELINUX_COLOR=$WHITE
fi

echo -e "${BOLD}${YELLOW}Security & Service Health${NC}"
echo -e "  ${GREEN}SSH Connections:${NC}   ${SSH_CONNECTIONS}"
echo -e "  ${GREEN}Failed Logins:${NC}     ${FAILED_LOGIN_COUNT}"
echo -e "  ${GREEN}Failed Services:${NC}   ${SERVICE_COLOR}${FAILED_SERVICES}${NC}"
echo -e "  ${GREEN}Root SSH Login:${NC}    ${ROOT_SSH_COLOR}${ROOT_SSH_SETTING}${NC}"
echo -e "  ${GREEN}Password Auth:${NC}     ${PASSWORD_AUTH_COLOR}${PASSWORD_AUTH_SETTING}${NC}"
echo -e "  ${GREEN}Firewall Status:${NC}   ${FIREWALL_COLOR}${FIREWALL_STATUS}${NC}"
echo -e "  ${GREEN}SELinux Status:${NC}    ${SELINUX_COLOR}${SELINUX_STATUS}${NC}"
echo

# Top processes
TOP_CPU_PROCESS=$(ps -eo comm,%cpu --sort=-%cpu 2>/dev/null | awk 'NR==2 {print $1 " - " $2 "%"}')
TOP_MEM_PROCESS=$(ps -eo comm,%mem --sort=-%mem 2>/dev/null | awk 'NR==2 {print $1 " - " $2 "%"}')

TOP_CPU_PROCESS=$(safe_value "$TOP_CPU_PROCESS" "Unavailable")
TOP_MEM_PROCESS=$(safe_value "$TOP_MEM_PROCESS" "Unavailable")

echo -e "${BOLD}${YELLOW}Top Processes${NC}"
echo -e "  ${GREEN}Top CPU Process:${NC}   ${TOP_CPU_PROCESS}"
echo -e "  ${GREEN}Top Memory Process:${NC} ${TOP_MEM_PROCESS}"
echo

print_line
echo -e "${BOLD}${CYAN}  Admin Reminder:${NC} Check failed services, reboot status, disk usage, firewall, and security updates first."
echo -e "${CYAN}  Useful Commands: ${YELLOW}systemctl --failed${CYAN} | ${YELLOW}journalctl -xe${CYAN} | ${YELLOW}df -h${CYAN} | ${YELLOW}ss -tuln${NC}"
print_line
echo
